<mujoco model="hshop_balancing_robot">
    <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>
    <option integrator="RK4" timestep="0.002"/> <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300"/>
        <material name="grid" texture="grid" texrepeat="10 10"/>
    </asset>

    <worldbody>
        <light diffuse=".5 .5 .5" pos="0 0 3" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="5 5 0.1" material="grid" friction="1 0.05 0.01"/>

        <body name="chassis" pos="0 0 0.05">
            <joint name="root" type="free"/>
            <geom name="base_plate" type="box" size="0.0325 0.07 0.003" rgba="0.1 0.1 0.1 1"/>
            <inertial pos="0 0 0.02" mass="0.25" diaginertia="0.0005 0.0005 0.0005"/>

            <body name="top_tier" pos="0 0 0.045">
                <geom name="top_plate" type="box" size="0.0325 0.07 0.003" rgba="0.1 0.1 0.1 1"/>
                <geom name="battery" type="box" size="0.02 0.05 0.015" pos="0 0 0.02" rgba="0 0 0.8 1"/>
                <inertial pos="0 0 0.02" mass="0.45" diaginertia="0.001 0.001 0.001"/>
            </body>

            <body name="left_wheel" pos="0 0.098 -0.0175">
                <joint name="left_wheel_joint" type="hinge" axis="0 1 0"/>
                <geom name="left_wheel_geom" type="cylinder" size="0.0325 0.013" rgba="0.2 0.2 0.2 1" 
                      quat="0.707 0.707 0 0" friction="1.5 0.01 0.001" solref="0.01 1" solimp="0.9 0.95 0.001"/>
            </body>

            <body name="right_wheel" pos="0 -0.098 -0.0175">
                <joint name="right_wheel_joint" type="hinge" axis="0 1 0"/>
                <geom name="right_wheel_geom" type="cylinder" size="0.0325 0.013" rgba="0.2 0.2 0.2 1" 
                      quat="0.707 0.707 0 0" friction="1.5 0.01 0.001" solref="0.01 1" solimp="0.9 0.95 0.001"/>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name="left_motor" joint="left_wheel_joint" gear="0.2" ctrllimited="true" ctrlrange="-1 1"/>
        <motor name="right_motor" joint="right_wheel_joint" gear="0.2" ctrllimited="true" ctrlrange="-1 1"/>
    </actuator>
</mujoco>